# Flask security
SECRET_KEY=change-this-to-a-long-random-value
COOKIE_SECURE=0

# Google Gemini Developer API
# Create a key in Google AI Studio. Never commit the real key to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_USE_SEARCH=auto

# Email OTP verification (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=your-sender@gmail.com
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_HASH_SECRET=change-this-to-another-long-random-value

# Google Sign-In OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank to generate from the current request host.
# For Render you can explicitly set:
# GOOGLE_REDIRECT_URI=https://bharatassist-ai.onrender.com/auth/google/callback
