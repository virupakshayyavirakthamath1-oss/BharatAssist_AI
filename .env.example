# Flask security
SECRET_KEY=change-this-to-a-long-random-value
COOKIE_SECURE=0

# Google Gemini Developer API
# Create a key in Google AI Studio. Never commit the real key to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# auto = search only when freshness matters; 1 = use Google Search grounding for every question; 0 = never use it
GEMINI_USE_SEARCH=auto
